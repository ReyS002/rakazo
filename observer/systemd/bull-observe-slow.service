# EXAMPLE ONLY - not installed. projects + vault + narrow + nrs + journals + phasec + robinhood
# (git + file reads + read-only SQLite + one loopback GET; no outside network).
# narrow: Bull Pilot lane db opened mode=ro; if that fails it reads a copy in the private /tmp (PrivateTmp).
# robinhood: GET http://127.0.0.1:28188/health only (deps.LOCAL_ROUTES) -> AF_INET + localhost allowed, all else denied.
# journals/phasec after-close freshness: the 15-min timer picks up the ~16:23-16:28 ET exports by ~16:45 ET.
[Unit]
Description=Bull Desk oversight collector (projects, vault, narrow, nrs, journals, phasec, robinhood)

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -I /opt/stacks/bull-desk/observer/collect.py --only projects,vault,narrow,nrs,journals,phasec,robinhood --once
TimeoutStartSec=90
Nice=15
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/stacks/bull-desk/hermes-bridge-run/observe
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
